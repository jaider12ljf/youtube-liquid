{
  "name": "youtube-glass",
  "version": "1.0.0",
  "description": "YouTube con estilo Liquid Glass",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "set YTG_DEMO=1&& electron .",
    "dist": "electron-builder --win nsis"
  },
  "author": "Jaider Silva",
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@fontsource-variable/inter": "^5.3.0"
  },
  "productName": "YouTube",
  "build": {
    "appId": "com.jaider.youtube.liquidglass",
    "productName": "YouTube",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/demo.js",
      "build/icon.png",
      "GUIA-GOOGLE-CLOUD.md",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube",
      "installerIcon": "build/icon.ico",
      "uninstallDisplayName": "YouTube (Liquid Glass)",
      "artifactName": "YouTube-Instalador.exe"
    }
  }
}